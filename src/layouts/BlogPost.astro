---
import { render, type CollectionEntry } from "astro:content";

import BaseLayout from "./Base.astro";
import TOC from "@/components/blog/TOC.astro";
import BlogHero from "@/components/blog/Hero.astro";
import Comment from "@/components/Comment.astro";

interface Props {
	post: CollectionEntry<"post">;
}

const { post } = Astro.props;
const {
	data: { title, description, ogImage, publishDate, updatedDate },
	id,
} = post;
const slug = id.replace(/\/index$/, "");
const socialImage = ogImage ?? `/og-image/${slug}.png`;
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString();
const headings: Array<import("astro").MarkdownHeading> = (await render(post)).headings;
---

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const targetHeader = document.getElementById("blog-hero") as HTMLDivElement;

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			scrollBtn.dataset.show = (!entry.isIntersecting).toString();
		});
	}

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({ top: 0, behavior: "smooth" });
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);
</script>

<BaseLayout meta={{ title, description, articleDate, ogImage: socialImage }}>
	<div class="gap-x-10 lg:flex lg:items-start">
		{!!headings.length && <TOC headings={headings} />}
		<article class="min-w-0 flex-1 break-words" data-pagefind-body>
			<div id="blog-hero"><BlogHero content={post} /></div>
			<div
				class="prose prose-sm prose-cactus mt-12 max-w-none prose-headings:font-semibold prose-headings:text-accent-2 prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-code:rounded-md prose-code:bg-muted prose-code:px-1.5 prose-code:py-0.5 prose-code:text-sm prose-code:font-normal prose-pre:border prose-pre:border-borderColor prose-blockquote:border-l-2 prose-blockquote:border-accent prose-blockquote:pl-4 prose-blockquote:text-textSecondary prose-blockquote:not-italic"
			>
				<slot />
				<Comment />
			</div>
		</article>
	</div>

	{/* Back to Top */}
	<button
		id="to-top-btn"
		class="fixed bottom-8 end-4 z-30 flex h-10 w-10 translate-y-28 items-center justify-center rounded-full border border-borderColor bg-surface text-textSecondary opacity-0 shadow-lg transition-all duration-300 hover:border-accent/30 hover:text-accent data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12"
		aria-label="Back to Top"
		data-show="false"
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			aria-hidden="true"
			focusable="false"
			fill="none"
			viewBox="0 0 24 24"
			stroke-width="2"
			stroke="currentColor"
			class="h-5 w-5"
		>
			<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"></path>
		</svg>
	</button>
</BaseLayout>
