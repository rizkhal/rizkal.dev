---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	title: "About",
	description: "About Rizkal Lamaau - full-stack developer from Indonesia",
};
---

<PageLayout meta={meta}>
	<section class="reveal">
		<h1 class="text-3xl font-bold tracking-tight text-accent-2">About</h1>
	</section>

	<div class="mt-8 grid gap-8 lg:grid-cols-[1fr_auto]">
		<div class="space-y-6 reveal reveal-2">
			<div class="card-outer">
				<div class="card-inner space-y-4">
					<p class="leading-relaxed text-textSecondary">
						Halo! Saya <strong class="text-accent-2">Rizkal Lamaau</strong>, seorang generalis
						yang bekerja dengan Bahasa Pemrograman PHP &amp; Javascript. Saya menggunakan
						framework populer seperti Laravel dan NodeJS untuk Backend, React, Vue, dan
						Tailwind untuk Frontend.
					</p>
					<p class="leading-relaxed text-textSecondary">
						Saya percaya bahwa teknologi yang baik adalah yang menyelesaikan masalah nyata.
						Blog ini adalah tempat saya berbagi catatan, eksperimen, dan pemikiran seputar
						dunia pengembangan perangkat lunak.
					</p>
				</div>
			</div>

			<div class="card-outer">
				<div class="card-inner space-y-3">
					<p class="eyebrow">Tech Stack</p>
					<div class="flex flex-wrap gap-2">
						{["PHP", "Laravel", "NodeJS", "React", "Vue", "Tailwind", "MySQL", "Docker"].map((tech) => (
							<span class="rounded-full bg-muted px-3 py-1 text-xs font-medium text-textSecondary">
								{tech}
							</span>
						))}
					</div>
				</div>
			</div>
		</div>

		{/* Avatar card */}
		<div class="reveal reveal-3 lg:w-56">
			<div class="card-outer">
				<div class="card-inner flex flex-col items-center gap-3 text-center">
					<div class="flex h-24 w-24 items-center justify-center rounded-full bg-accent/10 font-mono text-2xl text-accent">
						RL
					</div>
					<div>
						<p class="font-semibold text-accent-2">Rizkal Lamaau</p>
						<p class="text-xs text-textSecondary">Full-Stack Developer</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</PageLayout>
