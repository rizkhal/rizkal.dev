---
import PageLayout from "@/layouts/Base.astro";
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";

const allPosts = await getAllPosts();
const allTags = getUniqueTagsWithCount(allPosts);

const meta = {
	title: "All Tags",
	description: "A list of all the topics I've written about in my posts",
};
---

<PageLayout meta={meta}>
	<div class="mb-8 reveal">
		<h1 class="text-3xl font-bold tracking-tight text-accent-2">Tags</h1>
		<p class="mt-2 text-textSecondary">{allTags.length} tag{allTags.length !== 1 ? "s" : ""}</p>
	</div>

	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{
			allTags.map(([tag, val], i) => (
				<a
					href={`/tags/${tag}/`}
					class={`card-outer group reveal reveal-${Math.min(i + 1, 6)}`}
					rel="prefetch"
				>
					<div class="card-inner flex items-center justify-between">
						<span class="font-medium text-accent-2 transition-colors group-hover:text-accent">
							#{tag}
						</span>
						<span class="rounded-full bg-muted px-2.5 py-0.5 text-xs text-textSecondary">
							{val}
						</span>
					</div>
				</a>
			))
		}
	</div>
</PageLayout>
