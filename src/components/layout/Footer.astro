---
import { menuLinks, siteConfig } from "@/site-config";

const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-4xl px-4 pb-6 sm:px-8">
	<div class="card-outer">
		<div class="card-inner flex flex-col items-center justify-between gap-4 sm:flex-row">
			<p class="text-sm text-textSecondary">
				&copy; {year} {siteConfig.author}
			</p>
			<nav aria-label="More on this site" class="flex gap-x-4">
				{
					menuLinks.map((link) => (
						<a
							href={link.path}
							class="text-sm text-textSecondary transition-colors hover:text-accent"
							rel="prefetch"
						>
							{link.title}
						</a>
					))
				}
			</nav>
		</div>
	</div>
</footer>
