---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}

const {
	heading: { slug, text, depth, subheadings },
} = Astro.props;
---

<li>
	<a
		class={`block text-textSecondary transition-colors hover:text-accent ${depth <= 2 ? "text-xs font-medium" : "ps-3 text-[0.6875rem]"}`}
		href={`#${slug}`}
	>
		{text}
	</a>
	{
		!!subheadings.length && (
			<ul class="mt-0.5 space-y-0.5">
				{subheadings.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ul>
		)
	}
</li>
