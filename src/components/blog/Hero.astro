---
import { Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import FormattedDate from "../FormattedDate.astro";

interface Props {
	content: CollectionEntry<"post">;
}

const { content } = Astro.props;
const { data } = content;

const { remarkPluginFrontmatter } = await render(content);
const minutesRead = (remarkPluginFrontmatter as Record<string, string>)?.minutesRead ?? "";

const dateTimeOptions: Intl.DateTimeFormatOptions = {
	month: "long",
};
---

<div class="reveal">
	{/* Cover Image with double-bezel */}
	{data.coverImage && (
		<div class="card-outer mb-8 overflow-hidden">
			<div class="card-inner overflow-hidden p-0">
				<Image
					src={data.coverImage.src}
					alt={data.coverImage.alt}
					class="aspect-video w-full object-cover"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
	)}

	{/* Meta */}
	<div class="mb-2 flex flex-wrap items-center gap-x-4 gap-y-1">
		<p class="eyebrow">
			<FormattedDate date={data.publishDate} dateTimeOptions={dateTimeOptions} />
			{minutesRead && <span> &middot; {minutesRead}</span>}
		</p>
		{data.updatedDate && (
			<span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-[0.6875rem] text-accent">
				Updated <FormattedDate date={data.updatedDate} dateTimeOptions={dateTimeOptions} />
			</span>
		)}
	</div>

	{/* Title */}
	<h1 class="text-3xl font-bold leading-tight tracking-tight text-accent-2 sm:text-4xl">{data.title}</h1>

	{/* Tags */}
	{!!data.tags?.length && (
		<div class="mt-4 flex flex-wrap gap-2">
			{data.tags.map((tag) => (
				<a
					class="rounded-full bg-muted px-3 py-1 text-xs font-medium text-textSecondary transition-colors hover:bg-accent/10 hover:text-accent"
					href={`/tags/${tag}/`}
					data-pagefind-filter="tag"
				>
					#{tag}
				</a>
			))}
		</div>
	)}
</div>
